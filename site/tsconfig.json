{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"], "allowJs": false,
    "noEmit": true, "esModuleInterop": true, "module": "ESNext",
    "moduleResolution": "Bundler", "resolveJsonModule": true,
    "isolatedModules": true, "jsx": "react-jsx", "incremental": true,
    "allowImportingTsExtensions": true,
    "plugins": [{"name":"next"}], "skipLibCheck": true
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "components/**/*.tsx", "lib/**/*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "out", "scripts", "test"]
}
