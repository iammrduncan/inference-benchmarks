# Secret references for benchmark runs. Safe to commit: it holds 1Password
# references, never values. 1Password injects the values at run time:
#
#   op run --env-file=benchmarks.env.op -- <command>
#
# Vault "benchmarks", secure note "keys". Field names as stored in 1Password:
#   jev_key  -> TypeSafe Jev API key
#   cerebras -> Cerebras API key

CEREBRAS_API_KEY=op://benchmarks/keys/cerebras
JEV_KEY=op://benchmarks/keys/jev_key

# Add a field to the note, then a line here, when a new provider is benchmarked:
# ANTHROPIC_API_KEY=op://benchmarks/keys/anthropic
# OPENROUTER_API_KEY=op://benchmarks/keys/openrouter
# HF_TOKEN=op://benchmarks/keys/hf
